APP_NAME="Live Sports"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_DATABASE is relative to database/ folder by default for sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

API_SPORTS_KEY=
API_SPORTS_FOOTBALL_BASE=https://v3.football.api-sports.io
API_SPORTS_BASKETBALL_BASE=https://v1.basketball.api-sports.io
SPORTS_CACHE_TTL=600
SPORTS_SYNC_HORIZON_HOURS=48

VITE_APP_NAME="${APP_NAME}"
